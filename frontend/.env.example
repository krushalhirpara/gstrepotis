# ====================================================================
# GST Suite Frontend - Environment Variables Template
# ====================================================================
# Production backend API URL:
VITE_API_URL=https://api.gstrepotis.com

# For local development with Laravel local server:
# VITE_API_URL=http://localhost:8000

# For testing against Laravel Cloud staging URL:
# VITE_API_URL=https://gstrepotis-production-okb4n3.laravel.cloud

# IMPORTANT:
# - Only public variables prefixed with VITE_ are exposed to client bundle.
# - DO NOT put backend secrets, database passwords, or private API keys here.
